import seaborn as sns
import matplotlib.pyplot as plt
import numpy as np


sns.set_theme()


## Question ! ##
random_data = np.random.normal(loc=70, scale=10, size=200)
mean_val = np.mean(random_data)
# print(random_data)

plt.hist(random_data, bins=20, color = "skyblue", edgecolor = "black", alpha = 0.8)
plt.axvline(
    mean_val,
    color = "red",
    linestyle = "--"
)



## QUESTION 2 ##

penguins = sns.load_dataset("penguins")
penguins


sns.relplot(
    data = penguins,
    x = "flipper_length_mm",
    y = "body_mass_g",
    hue = "species"
)


## QUESTION 3 ##
tips =  sns.load_dataset("tips")
sns.boxplot(
    data = tips,
    x = "total_bill",
    y = "day",
    hue = "sex"
    
)


## QUESTION 4 ##
sns.relplot(
    data = tips,
    x = "total_bill",
    y = "tip",
    hue = "sex",
    style = "smoker"
)


pivot_table = tips.pivot_table(index="day", columns= "time", values= "tip", aggfunc= "mean", observed= False)
pivot_table


sns.heatmap(
    data = pivot_table,
    cmap = "coolwarm"
)



