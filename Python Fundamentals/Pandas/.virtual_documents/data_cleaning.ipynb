import pandas as pd


## Handling missing values ##

df = pd.read_csv("raw_data.csv")
df.isnull()
df.isnull().sum()
df.dropna() ## drop the rows in which there is a null value
df.dropna(axis = 1) ## drops the columns in which there are any null values
df.fillna("NULL") ## Fills the the null values with any value you pass
df["age"].fillna(df["age"].mean())
df.iloc[2].fillna("NULL")


df


## Handling Duplicate values ##

df.duplicated() ## checks how many duplicated values are there in our data 
df[["country", "gender"]].duplicated() ## checks duplicated values for country column 
df.drop_duplicates()


## Hnadling Data TyPES

df.dtypes

df2 = df.copy()
df2["age"] = df2["age"].fillna(0)
df2["age"] = df2["age"].astype("int64")
df2
df2.dtypes

